<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
    <Domain id="any">
        <General>
            <!-- Kunci komunikasi ROS 2 hanya melalui antarmuka Tailscale (Virtual Mesh VPN) -->
            <NetworkInterfaceAddress>tailscale0</NetworkInterfaceAddress>
            <AllowMulticast>false</AllowMulticast>
            <EnableMulticastLoopback>true</EnableMulticastLoopback>
        </General>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
            <Peers>
                <!-- 1. LOCALHOST & LOCAL JETSON (Wajib agar sesama proses di Jetson saling mendeteksi!) -->
                <Peer address="127.0.0.1"/>
                <Peer address="100.84.182.79"/>

                <!-- 2. REMOTE PEERS -->
                <Peer address="100.127.135.67"/>  <!-- Laptop Faid (Linux) -->
                <Peer address="100.113.121.4"/>   <!-- Laptop Eganurf (Linux) -->
                <Peer address="100.65.225.99"/>    <!-- Laptop Divala (Windows) -->
                <Peer address="100.111.27.6"/>     <!-- Laptop Rifdah (Windows) -->
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>
